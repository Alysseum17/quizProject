# --- APP CONFIGURATION ---
NODE_ENV=test
PORT=3001

# --- SECURITY ---
# Secret must be at least 32 chars long for security best practices
JWT_SECRET="test_jwt_secret_key_for_testing_only_min_32_chars"
JWT_EXPIRES_IN=1h
RESET_TOKEN_EXPIRY_MINUTES=10

# --- DATABASE CREDENTIALS ---
# These are used by docker-compose to initialize the test database container
POSTGRES_USER=test_user
POSTGRES_PASSWORD=test_pass
POSTGRES_DB=quiz_test_db

# --- DATABASE CONNECTION STRING ---
# UNCOMMENT ONE OF THE OPTIONS BELOW DEPENDING ON YOUR ENVIRONMENT

# OPTION 1: LOCAL RUN (Local Machine)
# Use this if you run 'npm test' locally, but the DB is in Docker mapped to port 5433 (or 5432)
DATABASE_URL="postgresql://test_user:test_pass@localhost:5433/quiz_test_db?schema=public"

# OPTION 2: DOCKER RUN (Inside Container)
# Use this if you run tests inside docker (e.g., 'docker-compose run app_test')
# The host must match the service name in docker-compose.yml (e.g., 'postgres_test' or 'db')
# DATABASE_URL="postgresql://test_user:test_pass@postgres_test:5432/quiz_test_db?schema=public"

# --- EMAIL SERVICE (MOCK) ---
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=test_username
EMAIL_PASSWORD=test_password
EMAIL_FROM=test@quiz-app.com