# ==============================================
# DATABASE INITIALIZATION (Docker)
# ==============================================
# These variables are used by docker-compose ONLY during the first run 
# to create the superuser and the initial database inside the container.
POSTGRES_USER=quizuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=quizdb

# ==============================================
# FILE PERMISSIONS (Linux/Fedora)
# ==============================================
# Your local user ID and group ID. 
# This prevents Docker from creating files owned by "root" (which you cannot edit).
# Run "id -u" and "id -g" in your terminal to find your specific values.
HOST_UID=1000
HOST_GID=1000

# ==============================================
# PRISMA CONNECTION STRING
# ==============================================
# The URL used by Prisma Client to connect to the database.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# IMPORTANT:
# - If running app locally (npm run dev): use "localhost"
# - If running app in Docker: use the service name (e.g., "db" or "postgres")
DATABASE_URL="postgresql://quizuser:change_me@localhost:5432/quizdb?schema=public"

# ==============================================
# SECURITY & AUTHENTICATION (JWT)
# ==============================================
# The secret key used to sign and verify JSON Web Tokens.
# Should be a long, random string (e.g., generated via `openssl rand -base64 32`).
JWT_SECRET=generate_random_64_char_string

# Token validity duration (e.g., 1h, 7d).
JWT_EXPIRES_IN=7d

# Expiration time for password reset tokens (in minutes).
RESET_TOKEN_EXPIRY_MINUTES=10

# ==============================================
# EMAIL SERVICE (SMTP)
# ==============================================
# Configuration for sending emails (welcome emails, password resets).
# For development, services like Mailtrap.io are recommended to avoid sending real spam.
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USERNAME=your_mailtrap_username
EMAIL_PASSWORD=your_mailtrap_password
EMAIL_FROM=noreply@quiz-app.com

# ==============================================
# APPLICATION SETTINGS
# ==============================================
# Environment mode: 'development', 'production', or 'test'.
NODE_ENV=development

# The port on which the Express server will listen.
PORT=3000